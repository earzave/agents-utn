# Copiar a labs/python/.env y completar. Nunca commitear .env (cubierto por .gitignore).
# Mismos nombres de variable que apps/server/.env.example — decisión D4:
# Ollama Cloud (OpenAI-compatible). Ver .github/docs/decisiones.md.
# El entorno virtual vive en labs/python/.venv/ (ver ficha 3F-Py, "Preparar el entorno").

# --- LLM provider ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Embeddings ---
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
EMBEDDINGS_DIMENSIONS=

# Las fases siguientes agregan sus variables acá (mismos nombres que apps/server).
