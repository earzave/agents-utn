# Copiar a .env y completar. Nunca commitear .env (ya está en .gitignore).

# --- Server ---
PORT=3000
# Origen del lab de pruebas (Vite dev server en apps/web) para CORS
WEB_ORIGIN=http://localhost:5173

# --- LLM provider (fase 0+) — decisión D4: Ollama Cloud (OpenAI-compatible) ---
# Base URL OpenAI-compatible (API remota o local, ej. Ollama/LM Studio)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Embeddings (fase 1+) — decisión D4: Ollama Cloud ---
# IMPORTANTE (T-10): antes de la Fase 1, verificar con un script mínimo que el
# endpoint de embeddings responde (ej: curl al /embeddings con 1 frase).
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
# Dimensión del modelo de embeddings elegido (la usa el vector store)
EMBEDDINGS_DIMENSIONS=

# Las fases siguientes agregan sus variables acá (DB, vector store, etc.).
